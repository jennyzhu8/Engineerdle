{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "engineerdle.vercel.app" }],
      "destination": "https://engineerdle.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/api/site?path=/about" },
    { "source": "/how-to-play", "destination": "/api/site?path=/how-to-play" },
    { "source": "/privacy", "destination": "/api/site?path=/privacy" },
    { "source": "/contact", "destination": "/api/site?path=/contact" },
    { "source": "/concepts", "destination": "/api/site?path=/concepts" },
    { "source": "/concept/:slug", "destination": "/api/site?path=/concept/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/site?path=/sitemap.xml" }
  ]
}
